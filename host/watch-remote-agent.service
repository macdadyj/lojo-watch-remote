[Unit]
Description=Grok agent server for Watch Remote
After=network-online.target

[Service]
Type=simple
# This process speaks ACP to grok. It does not transcribe Watch audio.
# That runs in watch-remote-outbound.service (WATCHREMOTE_STT_COMMAND).
ExecStart=%h/.local/bin/watch-remote-agent
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
