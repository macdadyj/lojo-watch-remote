#!/bin/bash
# Listens on 127.0.0.1:2419 for Watch Remote.
# The phone key can only forward to that port. This process checks the agent
# secret, then talks to grok. Headless prompts run here, not through SSH.
# The secret is read from a mode-0600 file into the environment. It is not an argument.
set -euo pipefail

secret_file="${GROK_AGENT_SECRET_FILE:-${HOME}/.config/watch-remote/agent-secret}"
if [[ ! -f "${secret_file}" ]]; then
  echo "Missing ${secret_file}. See docs/HOST-SETUP.md." >&2
  exit 1
fi
GROK_AGENT_SECRET="$(tr -d '[:space:]' < "${secret_file}")"
export GROK_AGENT_SECRET
if [[ -z "${GROK_AGENT_SECRET}" ]]; then
  echo "Agent secret file is empty." >&2
  exit 1
fi

root="$(cd "$(dirname "$0")" && pwd)"
bin="${GROK_BIN:-${HOME}/.grok/bin/grok}"
if [[ ! -x "${bin}" ]]; then
  bin="grok"
fi

# grok's own listener is on an internal port the phone key cannot forward to.
# Its startup line includes the secret, so it is not written to the log.
internal="${WATCHREMOTE_AGENT_INTERNAL:-127.0.0.1:2420}"
if [[ -x "${bin}" ]] || command -v "${bin}" >/dev/null 2>&1; then
  "${bin}" agent serve --bind "${internal}" >/dev/null 2>&1 &
  child=$!
  trap 'kill "${child}" >/dev/null 2>&1 || true' EXIT
fi

exec python3 "${root}/agentdoor.py"
